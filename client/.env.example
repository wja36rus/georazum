# Пример конфигурации: скопируйте в .env и заполните своими значениями.
# Сам .env в git не коммитится (см. .gitignore).

# Адрес развёрнутого бэкенда для продакшен-сборки (без /api), например:
#   API_URL=https://georazum-api.onrender.com
# Пустое значение = тот же origin: локальная разработка через dev-прокси (/api → 4000).
API_URL=

# Базовый путь при деплое в подпапку GitHub Pages (например /georazum/).
# Для локальной разработки оставьте "/".
BASE_PATH=/

# Режим моков (сайт работает без бэкенда, данные — в браузере):
#   USE_MOCKS=true  — всегда моки;
#   USE_MOCKS=false — всегда реальный API;
#   (не задано) — продакшен-сборка без API_URL включает моки автоматически;
#                 локальный dev и сборка с API_URL ходят на реальный API.
USE_MOCKS=
